# Backend (apps/api). Скопировать в .env и заполнить.

NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://ravonroad:ravonroad@localhost:5432/ravonroad?schema=public

# Cloupard S3 (внешнее S3-совместимое хранилище фото)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
# telegram_user_id модераторов через запятую. Источник первичного засева таблицы
# moderator при первом развёртывании; дальше состав меняется в БД, без передеплоя (ADR-0005)
TELEGRAM_MODERATOR_IDS=
