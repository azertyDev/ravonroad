# Backend (apps/api). Скопировать в .env и заполнить.

NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Одновременных запросов на POST /api/reports. Восемь на проде (8 × 8 МБ = 64 МБ буферов
# в худшем случае), два на dev — оверлей docker-compose.dev.yml ставит их сам (SRS §12.2).
INTAKE_CONCURRENCY=8

# Воркеров обработки фотографий. Один справляется со всплеском с шестикратным запасом;
# два понадобятся, если задержка хранилища окажется выше 200 мс на операцию (SRS §5.4).
# Ноль останавливает обработку, не трогая приём заявок.
PHOTO_WORKERS=1

# Сколько живёт снимок публичных точек и чисел счётчика, в миллисекундах. По умолчанию
# 30 000 — вдвое меньше требования PRD к задержке счётчика и ровно столько же, сколько
# живёт микрокэш nginx. Ноль отключает кэш: так делают тесты, которым нужны свежие данные.
POINTS_CACHE_TTL_MS=30000

# PostgreSQL + PostGIS.
# DATABASE_URL описывает доступ с хоста: его читают prisma CLI и pnpm dev. Порт 5432
# на хост отдаёт только dev-оверлей и только на 127.0.0.1, поэтому базу для разработки
# поднимать так:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
# Внутри docker compose строка собирается из POSTGRES_* и имени сервиса db.
DATABASE_URL=postgresql://ravonroad:ravonroad@localhost:5432/ravonroad?schema=public
POSTGRES_USER=ravonroad
POSTGRES_PASSWORD=ravonroad
POSTGRES_DB=ravonroad

# Origin, на котором edge отдаёт сайт. Из него api берёт WEB_ORIGIN для CORS.
PUBLIC_ORIGIN=http://localhost

# Адрес сайта, который увидит человек. Из него бот собирает ссылки на страницу заявки:
# номер RR-3471 в карточке волонтёрской группы и в digest — ссылка на /uz/reports/3471.
# Отдельно от PUBLIC_ORIGIN, потому что это разные адреса: сайт стенда открыт по https
# на <ip>.sslip.io, а CORS настроен на origin, которым edge отвечает. Ссылка, которую
# волонтёр откроет с телефона, обязана быть той, у которой сертификат.
PUBLIC_SITE_URL=http://localhost

# Домен сертификата Let's Encrypt. Пусто — edge работает по http, как раньше.
# На стенде это `<ip>.sslip.io`: домен покупать не нужно, а https обязателен, потому что
# без защищённого контекста браузер не даёт геолокацию (`navigator.geolocation`), не даёт
# `crypto.randomUUID`, а Telegram не принимает webhook. Выпуск: deploy/issue-cert.sh.
TLS_DOMAIN=
# Каталоги сертификатов и ACME-проверки. На сервере — внутри APP_DIR, локально не нужны.
LETSENCRYPT_DIR=
CERTBOT_WEBROOT=

# PMTiles-экстракт Ташкента: один файл, браузер читает его range-запросами. Ни ключей,
# ни лимитов, ни стороннего API на пути жителя к форме. Имя файла содержит дату сборки,
# поэтому он кэшируется навсегда: обновление экстракта — это новое имя и новое значение
# здесь. Пусто — карта не показывается, а точка выбирается кнопкой «моё местоположение»
# и полями широты и долготы (PRD §8.2).
#
# В контейнерах экстракт лежит в самом образе и адрес относительный — так первый тайл
# не стоит четырёх кругов к чужому хосту (ADR-0008 › Дополнение). Значение по умолчанию
# уже такое, и переопределять его на серверах не нужно:
#   VITE_MAP_PMTILES_URL=/map/tashkent-20260810.pmtiles
#
# Для `pnpm dev` статики нет, поэтому здесь стоит внешний адрес — он поддерживается
# по-прежнему и попадает в connect-src CSP, если задан (docker-compose.yml).
VITE_MAP_PMTILES_URL=https://storage.googleapis.com/ravonroad-dev-photos/map/tashkent-20260810.pmtiles

# Хранилище фотографий — диск сервера (ADR-0009). В контейнере это точка монтирования
# тома `photos`, а не путь внутри образа: образ пересоздаётся каждой выкаткой, снимки
# жителей — нет. Значение уже задано в docker-compose.yml; здесь оно нужно тому, кто
# запускает api вне контейнера (`pnpm dev`).
MEDIA_ROOT=./.photos

# Резервное копирование в S3-совместимое хранилище (deploy/backup.sh): туда уходят дампы
# базы и ночная копия фотографий. Само приложение эти ключи не читает — с переездом
# снимков на диск они нужны только скрипту бэкапа.
#
# Диск сервера — единственная копия фотографии до того, как отработает backup.sh. Пустые
# ключи здесь означают, что копий нет вовсе: на dev это норма, на проде — нет (SRS §10.5).
S3_ENDPOINT=https://storage.googleapis.com
S3_REGION=us-central1
S3_BUCKET=ravonroad-dev-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
# telegram_user_id модераторов через запятую. Источник первичного засева таблицы
# moderator при первом развёртывании; дальше состав меняется в БД, без передеплоя (ADR-0005)
TELEGRAM_MODERATOR_IDS=
# Секрет из заголовка X-Telegram-Bot-Api-Secret-Token — им проверяется отправитель
# webhook (SRS §9.3)
TELEGRAM_WEBHOOK_SECRET=
# Случайный сегмент пути webhook: .../api/telegram/webhook/<этот сегмент>.
# ВТОРОЙ эшелон обороны. ПЕРВЫЙ и обязательный — заголовок X-Telegram-Bot-Api-Secret-Token
# выше: он и решает, наш ли это запрос. Путь самостоятельной защитой не является и пустым
# просто не проверяется (SRS §9.3). Сгенерировать: openssl rand -hex 16
TELEGRAM_WEBHOOK_PATH=
# Адрес Bot API. Пусто — https://api.telegram.org. Подменяется только в тестах
TELEGRAM_API_BASE_URL=
# Приватный чат координатора, куда бот шлёт алерты (SRS §10.4). НЕ группа волонтёров:
# сообщение о переполненной очереди адресовано дежурному, а не тем, кто в ней стоит.
# Пусто — алерты выключены, и api пишет об этом warn на старте: «настроено» и «выключено»
# выглядят одинаково ровно до первой поломки. Свой id можно узнать у @userinfobot.
TELEGRAM_ALERT_CHAT_ID=

# --- Только на серверах, локально не нужны. Файл пишет deploy/bootstrap-dev.sh, теги
# --- проставляет deploy/deploy.sh; руками сюда лезть незачем. Подробности — docs/deploy.md.

# Префикс образов в GHCR без суффикса сервиса и тега: deploy.sh достраивает из него
# GHCR_REPO-api:TAG, GHCR_REPO-edge:TAG, GHCR_REPO-migrate:TAG
GHCR_REPO=ghcr.io/azertydev/ravonroad
# sha развёрнутого сейчас коммита. Пишется после успешного health-check
IMAGE_TAG=
# sha, работавший до текущей выкатки. Это и есть точка отката
PREVIOUS_IMAGE_TAG=
