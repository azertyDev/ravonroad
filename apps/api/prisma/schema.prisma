generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Миграции пишутся руками, а не `prisma migrate dev`. Схема содержит объекты, которых
// Prisma не описывает: CHECK-инварианты (SRS §2.2), частичные индексы (§2.2, §2.4) и
// колонку geography (§2.14). Сгенерированная миграция снесла бы их при следующем запуске.

/** 12 районов Ташкента. Единственная таблица с геометрией во всей схеме (ADR-0003):
 *  point-in-polygon и геозабор — один запрос по `geom`, у заявки же обычные широта
 *  и долгота, доступные штатному Prisma Client.
 *
 *  `geom` — `Unsupported`, поэтому строка создаётся только сырым SQL. Это не помеха:
 *  таблица наполняется миграцией из data/geo/tashkent-districts.geojson и после этого
 *  не меняется. Появление второго `Unsupported` — повод пересмотреть ADR-0003. */
model District {
  code   String @id @db.VarChar(32)
  nameUz String @map("name_uz") @db.VarChar(120)
  nameRu String @map("name_ru") @db.VarChar(120)
  nameEn String @map("name_en") @db.VarChar(120)
  /** Из датасета хокимията. Хранится, чтобы сверять сид с источником (SRS §2.6). */
  areaHa Int    @map("area_ha")

  /** Считается при сиде из самой геометрии: «подогнать карту под район» (US-031)
   *  не должно дёргать PostGIS на каждый показ. */
  bboxMinLon Decimal @map("bbox_min_lon") @db.Decimal(9, 6)
  bboxMinLat Decimal @map("bbox_min_lat") @db.Decimal(9, 6)
  bboxMaxLon Decimal @map("bbox_max_lon") @db.Decimal(9, 6)
  bboxMaxLat Decimal @map("bbox_max_lat") @db.Decimal(9, 6)

  geom Unsupported("geography(MultiPolygon, 4326)")

  reports Report[]

  @@map("district")
}

/** Категория дефекта, которую выбирает житель (US-010).
 *
 *  Категории — данные, а не код (SRS §2.5): ни `enum` в Prisma, ни union в контракте.
 *  Добавление, перевод и скрытие категории выполняются `INSERT`/`UPDATE` — без миграции
 *  и без передеплоя. Отсюда же названия в таблице: переводы категорий не могут жить
 *  в словаре локали, иначе новая строка требовала бы пересборки фронта. */
model Category {
  id        Int     @id @default(autoincrement())
  code      String  @unique @db.VarChar(32)
  nameUz    String  @map("name_uz") @db.VarChar(120)
  nameRu    String  @map("name_ru") @db.VarChar(120)
  sortOrder Int     @map("sort_order") @db.SmallInt
  /** Вывод из оборота — `false`, не `DELETE`: старые заявки ссылаются на строку. */
  isActive  Boolean @default(true) @map("is_active")

  reports Report[]

  @@map("category")
}

/** Заявка — единица работы всей системы. Три идентификатора с разными ролями (SRS §2.1):
 *  `id` не покидает БД, `publicNumber` публичен и доступа не даёт, `trackingToken`
 *  секретен и является единственной capability в системе. Вывести один из другого нельзя
 *  ни хешем, ни подписью — это готовый IDOR (SRS §9.2).
 *
 *  Геометрии здесь нет: широта и долгота — обычные `Decimal`, поэтому таблица читается
 *  и пишется штатным Prisma Client (ADR-0003). */
model Report {
  id Int @id @default(autoincrement())

  /** `nextval`, а не `COUNT(*) + 1`: последовательность атомарна и не берёт блокировок,
   *  а `COUNT` выдаёт дубликаты на первой же гонке. Пропуски номеров при откате
   *  транзакции — не дефект: номер обязан быть уникальным, а не плотным (SRS §2.1). */
  publicNumber Int @unique(map: "report_number_idx") @default(autoincrement()) @map("public_number")

  status ReportStatus @default(NEW)

  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /** Считает сервер point-in-polygon; значение из клиента не принимается (SRS §9.7). */
  districtCode String   @map("district_code") @db.VarChar(32)
  district     District @relation(fields: [districtCode], references: [code])

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  landmark String? @db.VarChar(200)

  contactPhone      String?   @map("contact_phone") @db.VarChar(20)
  contactTelegram   String?   @map("contact_telegram") @db.VarChar(64)
  contactsDeletedAt DateTime? @map("contacts_deleted_at") @db.Timestamptz(3)

  trackingToken  String  @unique(map: "report_token_idx") @map("tracking_token") @db.VarChar(24)
  idempotencyKey String? @unique(map: "report_idem_idx") @map("idempotency_key") @db.Uuid

  /** Решение модератора. */
  duplicateOfId Int?     @map("duplicate_of_id")
  duplicateOf   Report?  @relation("ReportDuplicate", fields: [duplicateOfId], references: [id])
  duplicates    Report[] @relation("ReportDuplicate")

  /** Гипотеза системы, а не решение: ближайшая открытая заявка в 50 м на момент
   *  создания (SRS §3.2). Статус она не меняет никогда. */
  duplicateCandidateOfId Int?     @map("duplicate_candidate_of_id")
  duplicateCandidateOf   Report?  @relation("ReportDuplicateCandidate", fields: [duplicateCandidateOfId], references: [id])
  duplicateCandidates    Report[] @relation("ReportDuplicateCandidate")

  statusReason     String? @map("status_reason") @db.VarChar(48)
  statusReasonText String? @map("status_reason_text") @db.VarChar(500)
  publicationUrl   String? @map("publication_url") @db.VarChar(512)

  /** Только антиабуз, публично не показывается, удаляется через 30 дней (SRS §9.8). */
  createdIp String? @map("created_ip") @db.Inet

  telegramAlbumMessageId Int? @map("telegram_album_message_id")
  telegramCardMessageId  Int? @map("telegram_card_message_id")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "report_list_idx")
  @@index([latitude, longitude], map: "report_bbox_idx")
  @@index([status], map: "report_status_idx")
  @@index([districtCode, status], map: "report_district_idx")
  @@map("report")
}

/** Семь значений глоссария. Начальное — `NEW`, и в этом срезе оно единственное:
 *  переходы появляются вместе с кнопками бота в 004. */
enum ReportStatus {
  NEW
  ACCEPTED
  IN_PROGRESS
  DONE
  REJECTED
  DUPLICATE
  OUT_OF_SCOPE

  @@map("report_status")
}
