generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Миграции пишутся руками, а не `prisma migrate dev`. Схема содержит объекты, которых
// Prisma не описывает: CHECK-инварианты (SRS §2.2), частичные индексы (§2.2, §2.4) и
// колонку geography (§2.14). Сгенерированная миграция снесла бы их при следующем запуске.

/** 12 районов Ташкента. Единственная таблица с геометрией во всей схеме (ADR-0003):
 *  point-in-polygon и геозабор — один запрос по `geom`, у заявки же обычные широта
 *  и долгота, доступные штатному Prisma Client.
 *
 *  `geom` — `Unsupported`, поэтому строка создаётся только сырым SQL. Это не помеха:
 *  таблица наполняется миграцией из data/geo/tashkent-districts.geojson и после этого
 *  не меняется. Появление второго `Unsupported` — повод пересмотреть ADR-0003. */
model District {
  code   String @id @db.VarChar(32)
  nameUz String @map("name_uz") @db.VarChar(120)
  nameRu String @map("name_ru") @db.VarChar(120)
  nameEn String @map("name_en") @db.VarChar(120)
  /** Из датасета хокимията. Хранится, чтобы сверять сид с источником (SRS §2.6). */
  areaHa Int    @map("area_ha")

  /** Считается при сиде из самой геометрии: «подогнать карту под район» (US-031)
   *  не должно дёргать PostGIS на каждый показ. */
  bboxMinLon Decimal @map("bbox_min_lon") @db.Decimal(9, 6)
  bboxMinLat Decimal @map("bbox_min_lat") @db.Decimal(9, 6)
  bboxMaxLon Decimal @map("bbox_max_lon") @db.Decimal(9, 6)
  bboxMaxLat Decimal @map("bbox_max_lat") @db.Decimal(9, 6)

  geom Unsupported("geography(MultiPolygon, 4326)")

  @@map("district")
}

/** Категория дефекта, которую выбирает житель (US-010).
 *
 *  Категории — данные, а не код (SRS §2.5): ни `enum` в Prisma, ни union в контракте.
 *  Добавление, перевод и скрытие категории выполняются `INSERT`/`UPDATE` — без миграции
 *  и без передеплоя. Отсюда же названия в таблице: переводы категорий не могут жить
 *  в словаре локали, иначе новая строка требовала бы пересборки фронта. */
model Category {
  id        Int     @id @default(autoincrement())
  code      String  @unique @db.VarChar(32)
  nameUz    String  @map("name_uz") @db.VarChar(120)
  nameRu    String  @map("name_ru") @db.VarChar(120)
  sortOrder Int     @map("sort_order") @db.SmallInt
  /** Вывод из оборота — `false`, не `DELETE`: старые заявки ссылаются на строку. */
  isActive  Boolean @default(true) @map("is_active")

  @@map("category")
}
