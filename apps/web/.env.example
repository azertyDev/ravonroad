# Frontend (apps/web). Скопировать в .env. Vite отдаёт в браузер только VITE_*.

# Контакт кампании в подвале: по нему житель просит удалить свои контакты
# и уточняет судьбу заявки (PRD §9.2.4). Заполняет владелец кампании.
VITE_CAMPAIGN_CONTACT_URL=

# PMTiles-экстракт Ташкента; пусто — карта не показывается, точка выбирается полями.
VITE_MAP_PMTILES_URL=https://storage.googleapis.com/ravonroad-dev-photos/map/tashkent-20260810.pmtiles
