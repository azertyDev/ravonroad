# TLS-сервер стенда. Файл попадает в работу только когда сертификат уже выпущен:
# /docker-entrypoint.d/20-enable-tls.sh проверяет его наличие и копирует этот шаблон
# в conf.d/tls/. Без сертификата nginx поднимается как раньше, по одному 80 порту,
# и остаётся пригоден для ACME-проверки — курица и яйцо разведены именно так.
#
# Здесь только порт и сертификат. Всё остальное — в site.conf, общем с сервером 80:
# копия маршрутов уже один раз разошлась с оригиналом и молча выключила микрокэш.

server {
  listen 443 ssl;
  http2 on;
  server_name ${TLS_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${TLS_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${TLS_DOMAIN}/privkey.pem;
  ssl_session_cache   shared:SSL:2m;
  ssl_session_timeout 1h;
  ssl_protocols       TLSv1.2 TLSv1.3;

  include /etc/nginx/site.conf;
}
