# Готовит адреса для CSP до того, как envsubst соберёт заголовок.
#
# 1. PHOTO_ORIGIN дописывается завершающим слэшем. В CSP путь источника без слэша значит
#    «ровно этот путь», а не префикс: `https://host/bucket` разрешал единственный адрес
#    и не разрешал `https://host/bucket/photos/ab/….jpg`. Карточка заявки показывала
#    битую картинку при, казалось бы, правильной политике.
#
# 2. MAP_PMTILES_URL очищается, если он относительный. С переносом экстракта в образ
#    адрес стал путём `/map/….pmtiles`, а путь без схемы и хоста — не источник CSP:
#    браузер отбросил бы его как мусор, а мы бы решили, что разрешение выдано. Тайлы
#    со своего origin покрывает `'self'`, и ничего дописывать не нужно. Внешний адрес
#    (бакет) по-прежнему поддерживается и попадает в политику как раньше.
#
# 3. Обе переменные объявляются даже пустыми: envsubst подставляет только объявленные,
#    а необъявленную оставляет в тексте — в заголовок уехала бы строка `${…}`.
#
# Расширение `.envsh`, а не `.sh`: entrypoint официального образа nginx такие файлы
# подключает через `.`, поэтому export доживает до шага envsubst. Бит `x` обязателен
# и для них: без него entrypoint пишет «Ignoring, not executable» и идёт дальше.
PHOTO_ORIGIN="${PHOTO_ORIGIN:-}"
MAP_PMTILES_URL="${MAP_PMTILES_URL:-}"

case "$PHOTO_ORIGIN" in
  '') ;;
  */) ;;
  *) PHOTO_ORIGIN="${PHOTO_ORIGIN}/" ;;
esac

case "$MAP_PMTILES_URL" in
  http://* | https://*) ;;
  *) MAP_PMTILES_URL='' ;;
esac

export PHOTO_ORIGIN MAP_PMTILES_URL
