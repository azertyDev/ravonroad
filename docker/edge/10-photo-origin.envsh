# Готовит PHOTO_ORIGIN до того, как envsubst соберёт CSP.
#
# 1. Дописывает завершающий слэш. В CSP путь источника без слэша означает «ровно этот
#    путь», а не префикс: `https://host/bucket` разрешает единственный адрес
#    `https://host/bucket` и не разрешает `https://host/bucket/photos/ab/….jpg`.
#    Из-за этого карточка заявки показывала битую картинку при, казалось бы, правильной
#    политике — браузер сообщал о нарушении `img-src` на адрес, написанный в этой самой
#    политике.
# 2. Объявляет переменную даже пустой. envsubst подставляет только объявленные
#    переменные, а необъявленную оставляет в тексте как есть — и в заголовок уехала бы
#    строка `${PHOTO_ORIGIN}`.
#
# Расширение `.envsh`, а не `.sh`: entrypoint официального образа nginx такие файлы
# **подключает** через `.`, а не запускает подпроцессом, поэтому export доживает
# до шага envsubst. Бит `x` обязателен и для них: без него entrypoint пишет
# «Ignoring, not executable» и молча идёт дальше.
PHOTO_ORIGIN="${PHOTO_ORIGIN:-}"

case "$PHOTO_ORIGIN" in
  '') ;;
  */) ;;
  *) PHOTO_ORIGIN="${PHOTO_ORIGIN}/" ;;
esac

export PHOTO_ORIGIN
