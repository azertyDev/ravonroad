# Заголовки безопасности SRS §9.8. Подключаются и в server, и в каждый location,
# где есть свой add_header: nginx не наследует add_header на уровень, где он объявлен
# заново, и молча потерял бы весь этот файл.
#
# Файл — шаблон: официальный образ nginx прогоняет /etc/nginx/templates/*.template
# через envsubst при старте и кладёт результат в /etc/nginx/conf.d/ под тем же именем.

add_header Referrer-Policy "no-referrer" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Permissions-Policy "geolocation=(self), camera=()" always;

# TLS терминируется здесь же, когда появится домен и сертификат (spec «требует решения», п.3).
# До этого заголовок отдаётся, но браузером по http игнорируется.
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

# Стороннего скрипта на странице больше нет: карта — это MapLibre из нашего же бандла,
# а тайлы лежат в нашем бакете. Адрес архива подставляется из MAP_PMTILES_URL при старте
# контейнера: на dev это GCS, на проде будет Cloupard, и зашивать его сюда нельзя.
# В connect-src идёт полный URL, а не хост: путь в CSP сверяется целиком, и разрешение
# получает ровно один файл, а не весь бакет.
# worker-src обязателен: MapLibre поднимает свой воркер через blob:, и без него карта
# не стартует вовсе.
#
# img-src содержит адрес публичного чтения бакета: фотографии заявок отдаёт он, а не мы.
# Чужой домен здесь обязателен и безопасен по той же причине, по которой он чужой —
# браузер не исполняет содержимое картинки на origin сайта (SRS §9.6). Пусто — карточка
# заявки показывает битую картинку, а в консоли одна строка про CSP: ровно так это
# и было найдено на стенде.
add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: ${PHOTO_ORIGIN}; script-src 'self'; worker-src 'self' blob:; connect-src 'self' ${MAP_PMTILES_URL}; frame-ancestors 'none'; base-uri 'none'" always;
