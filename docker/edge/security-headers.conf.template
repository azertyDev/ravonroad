# Заголовки безопасности SRS §9.8. Подключаются и в server, и в каждый location,
# где есть свой add_header: nginx не наследует add_header на уровень, где он объявлен
# заново, и молча потерял бы весь этот файл.
#
# Файл — шаблон: официальный образ nginx прогоняет /etc/nginx/templates/*.template
# через envsubst при старте и кладёт результат в /etc/nginx/conf.d/ под тем же именем.

add_header Referrer-Policy "no-referrer" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Permissions-Policy "geolocation=(self), camera=()" always;

# TLS терминируется здесь же, когда появится домен и сертификат (spec «требует решения», п.3).
# До этого заголовок отдаётся, но браузером по http игнорируется.
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

# Стороннего скрипта на странице больше нет: карта — это MapLibre из нашего же бандла,
# а тайлы лежат в нашем бакете. Адрес архива подставляется из MAP_PMTILES_URL при старте
# контейнера: на dev это GCS, на проде будет Cloupard, и зашивать его сюда нельзя.
# В connect-src идёт полный URL, а не хост: путь в CSP сверяется целиком, и разрешение
# получает ровно один файл, а не весь бакет.
# worker-src обязателен: MapLibre поднимает свой воркер через blob:, и без него карта
# не стартует вовсе.
#
# PHOTO_ORIGIN сейчас пуст, и это правильно: фотографии переехали на наш же диск и
# раздаются с нашего origin, который в img-src покрывает 'self' (ADR-0009). Переменная
# оставлена, потому что внешнее хранилище может вернуться, а пустая она обрабатывается
# штатно. Заполненная и без завершающего слэша она однажды уже дала битую картинку
# в карточке и одну строку про CSP в консоли — на это есть 10-csp-origins.envsh.
#
# blob: в img-src — предпросмотр в форме. Выбранную фотографию форма сжимает на устройстве
# и показывает через `URL.createObjectURL`, то есть ссылкой `blob:` на данные самой
# страницы; чужого содержимого такой источник впустить не может. Без него житель видел
# битую плитку вместо своего снимка и не понимал, взяли файл или нет.
add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: ${PHOTO_ORIGIN}; script-src 'self'; worker-src 'self' blob:; connect-src 'self' ${MAP_PMTILES_URL}; frame-ancestors 'none'; base-uri 'none'" always;
